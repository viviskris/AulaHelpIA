<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pastel"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con foto de perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Avatar circular -->
            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:background="@color/primary_light"
                android:padding="20dp"
                android:tint="@color/primary_pastel"
                android:contentDescription="Foto de perfil"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agregar nombre"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usuario@ejemplo.com"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Tarjeta: Información Personal -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información Personal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_pastel"
                    android:layout_marginBottom="12dp" />

                <!-- Nombre completo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nombre completo:"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por configurar"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <!-- Correo electrónico -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Correo electrónico:"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="usuario@ejemplo.com"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <!-- Última actualización -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Última actualización:"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvLastUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Tarjeta: Gestión del Embarazo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestión del Embarazo"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_pastel"
                    android:layout_marginBottom="12dp" />

                <!-- Información importante -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puedes ajustar las fechas después de tu primera ecografía para mayor precisión"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2sp"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp"
                    android:background="@color/primary_light"
                    android:backgroundTint="@color/primary_light" />

                <!-- Información de fechas actuales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:background="@color/primary_light"
                    android:backgroundTint="@color/primary_light">

                    <TextView
                        android:id="@+id/tvDueDateInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha de parto: No configurada"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLastPeriodInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Última regla: No configurada"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Botón para reiniciar fecha de parto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDueDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔄 Actualizar fecha de parto"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/accent_pastel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false" />

                <!-- Botón para reiniciar última regla -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetLastPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Actualizar fecha última regla"
                    app:backgroundTint="@color/secondary_pastel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Tarjeta: Preferencias de la App -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preferencias"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_pastel"
                    android:layout_marginBottom="12dp" />

                <!-- Notificaciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12px"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notificaciones"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

                <!-- Recordatorios de eventos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12px"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recordatorios de eventos"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchEventReminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Tarjeta: Acciones -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acciones"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_pastel"
                    android:layout_marginBottom="12dp" />

                <!-- Editar perfil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️ Editar perfil"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/primary_pastel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false" />

                <!-- Configurar hitos -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigureMilestones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Configurar hitos"
                    app:backgroundTint="@color/secondary_pastel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:textAllCaps="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 🆕 BANNER ADMOB -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-6126138750630663/8205829084" />

    </LinearLayout>

</ScrollView>