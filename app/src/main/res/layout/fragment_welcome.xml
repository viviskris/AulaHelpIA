<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background_pastel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Espacio superior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Icono - Usando ícono existente de Android -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="Bienvenida al embarazo"
            android:layout_marginBottom="32dp"
            android:tint="@color/primary_pastel" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenida a Creciendo Juntos!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompañaremos tu embarazo semana a semana con información, consejos y seguimiento personalizado."
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4sp"
            android:layout_marginBottom="48dp" />

        <!-- Espacio flexible -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comenzar mi viaje"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/primary_pastel"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            android:elevation="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Omitir por ahora"
            android:textSize="16sp"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/primary_pastel"
            app:strokeWidth="1dp"
            android:textColor="@color/primary_pastel"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>