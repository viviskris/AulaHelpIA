<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- TOOLBAR CON IDENTIDAD AULAHELPIA -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:backgroundTint="@color/purple_neon"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="📅 Mi Calendario AulaHelpIA"
            app:titleTextColor="@color/white" />

        <!-- SISTEMA DE BÚSQUEDA Y FILTROS AULAHELPIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_dark"
            android:elevation="2dp"
            android:padding="12dp">

            <!-- SearchView para búsqueda -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="🔍 Buscar en mis planes..."
                android:layout_marginBottom="8dp"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent" />

            <!-- ChipGroup para materias -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Todas"
                    android:checked="true"
                    app:chipBackgroundColor="@color/purple_neon"
                    app:checkedIconTint="@color/white"
                    app:chipStrokeColor="@color/purple_neon" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <!-- CONTENIDO PRINCIPAL DEL CALENDARIO AULAHELPIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header del Calendario con estilo AulaHelpIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/prevMonthButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="←"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/purple_neon"
                    style="@style/Widget.Material3.Button.IconButton" />

                <TextView
                    android:id="@+id/calendarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Noviembre 2024"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextMonthButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="→"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/purple_neon"
                    style="@style/Widget.Material3.Button.IconButton" />

                <!-- Botón Vista Mensual/Semanal -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Vista Semana"
                    android:textSize="12sp"
                    app:backgroundTint="@color/cyan_bright"
                    android:textColor="@color/white" />

            </LinearLayout>

            <!-- Días de la semana -->
            <GridView
                android:id="@+id/gvWeekDays"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@color/surface_dark"
                android:gravity="center"
                android:numColumns="7" />

            <!-- Calendario con altura fija -->
            <GridView
                android:id="@+id/gvCalendarDays"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="8dp"
                android:background="@color/surface_dark"
                android:gravity="center"
                android:horizontalSpacing="4dp"
                android:numColumns="7"
                android:verticalSpacing="4dp" />

            <!-- Leyenda - Solo Hoy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@color/surface_dark"
                android:elevation="1dp"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 "
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/circle_today" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoy"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Mensaje Motivacional -->
            <TextView
                android:id="@+id/tvMotivationalCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:background="@drawable/rounded_corner"
                android:text="Mensaje motivacional"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="italic"
                android:visibility="visible"/>

            <!-- ⏰ MI HORARIO SEMANAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:background="@color/surface_dark"
                android:padding="12dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏰ Mi Horario Semanal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_neon" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditHorario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️ Editar"
                        android:textSize="12sp"
                        app:backgroundTint="@color/cyan_bright"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        android:textAllCaps="false" />

                </LinearLayout>

                <!-- Contenedor del horario (se llenará desde código) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="horizontal"
                    android:paddingTop="8dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHorarioSemanal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </HorizontalScrollView>

                <!-- Mensaje cuando no hay horario -->
                <TextView
                    android:id="@+id/tvHorarioVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📌 Aún no has configurado tu horario.\nPresiona 'Editar' para agregar tus clases."
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ESTADÍSTICAS Y RESUMEN AULAHELPIA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Resumen del Mes -->
                <TextView
                    android:id="@+id/monthSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/month_summary_default"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Próximos Eventos -->
                <TextView
                    android:id="@+id/upcomingEventsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/upcoming_events_default"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BANNER ADMOB -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp"
            ads:adSize="BANNER"
            ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        <!-- ESPACIO EXTRA PARA SCROLL COMPLETO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>