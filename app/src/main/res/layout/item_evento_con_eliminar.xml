<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Fila 1: Contenido Principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Indicador de Categoría -->
            <View
                android:id="@+id/viewCategoryIndicator"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                app:backgroundTint="@color/purple_neon" />

            <!-- Contenido del Plan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Título del Plan -->
                <TextView
                    android:id="@+id/tvEventTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Reunión de equipo importante"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Descripción -->
                <TextView
                    android:id="@+id/tvEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Preparar presentación mensual con resultados"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Información de Fecha y Categoría -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Fecha -->
                    <TextView
                        android:id="@+id/tvEventDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="📅 Hoy 15:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Categoría -->
                    <TextView
                        android:id="@+id/tvEventCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/purple_neon"
                        android:backgroundTint="@color/task_pastel"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="💼 Trabajo"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Botón Eliminar -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar plan"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#FF757575" />

        </LinearLayout>

        <!-- 🆕 FILA INFERIOR: BOTONES DE ESTADO - IDENTIDAD AULHELPIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="6dp"
            android:background="@color/background_dark"
            android:backgroundTint="@color/purple_neon">

            <!-- Estado Actual -->
            <TextView
                android:id="@+id/tvCurrentState"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.3"
                android:layout_margin="3dp"
                android:text="🔵 Activo"
                android:textSize="11sp"
                android:gravity="center"
                android:textStyle="bold"
                android:background="@drawable/rounded_corner"
                app:backgroundTint="@color/purple_neon"
                android:textColor="@color/white" />

            <!-- Botón Completado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateCompletado"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:text="🎯"
                android:textSize="14sp"
                android:padding="0dp"
                app:backgroundTint="@color/completed_green"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />

            <!-- Botón Vencido -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateVencido"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:text="⏰"
                android:textSize="14sp"
                android:padding="0dp"
                app:backgroundTint="@color/overdue_red"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />

            <!-- Botón REPROGRAMADO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStateReprogramado"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:text="📅️"
                android:textSize="12sp"
                android:padding="0dp"
                app:backgroundTint="@color/pending_orange"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>



    </LinearLayout>

</androidx.cardview.widget.CardView>