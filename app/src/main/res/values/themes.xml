<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AulaHelpIA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Color primario (morado neón) -->
        <item name="colorPrimary">@color/purple_neon</item>
        <item name="colorPrimaryVariant">@color/purple_neon</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Color secundario (cian) -->
        <item name="colorSecondary">@color/cyan_bright</item>
        <item name="colorSecondaryVariant">@color/cyan_bright</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Fondo -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Color de superficie -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Color de fondo por defecto -->
        <item name="android:colorBackground">@color/background_dark</item>

        <!-- Color de acento para botones y elementos interactivos -->
        <item name="colorAccent">@color/purple_neon</item>

        <!-- Color de control (switch, checkbox, etc.) -->
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/purple_neon</item>
        <item name="colorControlHighlight">@color/purple_neon</item>

        <!-- Color de texto por defecto -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>